<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the SSH key pair stays on this device — never in cloud backups or device transfers -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="id_ed25519" />
        <exclude domain="file" path="id_ed25519.pub" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="id_ed25519" />
        <exclude domain="file" path="id_ed25519.pub" />
    </device-transfer>
</data-extraction-rules>
