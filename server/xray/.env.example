XRAY_PORT=443
# Optional override for the Android import link. If unset, render-share-link.sh
# can derive the address from HOST=root@your-vps-ip.
# XRAY_SERVER_ADDRESS=replace-with-vps-ip-or-domain
XRAY_USER_UUID=replace-with-xray-uuid
XRAY_REALITY_PRIVATE_KEY=replace-with-xray-x25519-private-key
XRAY_REALITY_DEST=github.com:443
XRAY_REALITY_SERVER_NAME=github.com
XRAY_REALITY_SHORT_ID=0123456789abcdef
XRAY_XHTTP_PATH=/tunnel-light-xhttp
XRAY_REALITY_PUBLIC_KEY=replace-with-xray-x25519-public-key
